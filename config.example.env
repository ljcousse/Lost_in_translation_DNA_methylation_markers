# Copy to config.env (kept local, not on GitHub) and fill in the local paths.
# Read by TargetedBisulphiteSeq.sh (source), AmpliconAwareMapping.R and TargetedBisulphite_analysis.R (readRenviron).
# Use another file with PROJECT_CONFIG=/path/to/file.env. Comments only on their own line.

# Working directory: input files (sample sheet, SupplementaryTable1.xlsx, clinical data) and all outputs
PROJECT_DIR=/path/to/project

# Optional: FALSE = fast run of the R analysis without the permutation tests and the simulation; their results are
# read from a previous run in PROJECT_DIR (only valid if M-values, samples and CpG pairs are unchanged). Default TRUE.
# RERUN_PERMUTATIONS=FALSE

# FASTQ files of sequencing run 231 (CRC, normal colon, ccRCC and part of the melanoma samples)
FASTQ_DIR_RUN231=/path/to/run231

# FASTQ files of sequencing run 239 (remaining melanoma samples)
FASTQ_DIR_RUN239=/path/to/run239
